---
import "@fontsource-variable/outfit";
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import { project, agency, agent, site, independenceNotice } from "../config/site";

const title =
  "USJ 7 Residences | New Launch Condo Near USJ7 LRT, Subang Jaya";
const description = `New launch freehold condo at Subang Jaya Xchange with a covered walkway to USJ7 LRT-BRT. 2 and 3-bedroom homes from 730 sqft. Marketed by ${agent.name} (${agent.ren}), ${agency.name}.`;
const ogImage = `${site.url}/assets/og-image.jpg`;

const apartmentComplex = {
  "@context": "https://schema.org",
  "@type": "ApartmentComplex",
  name: project.officialName,
  description:
    "Phase 2 of a freehold service apartment at Subang Jaya Xchange (SJX), USJ7, Subang Jaya, with a covered walkway to the USJ7 LRT-BRT interchange station. 2 to 3-bedroom flexi layouts of 730 and 920 sqft with hackable walls.",
  url: `${site.url}/`,
  image: ogImage,
  numberOfBedrooms: "2-3",
  containedInPlace: { "@type": "Place", name: "Subang Jaya Xchange (SJX), USJ7, Subang Jaya" },
  keywords: "new launch condo Subang Jaya, TOD condo Subang Jaya, condo near USJ7 LRT, freehold service apartment Subang Jaya",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Subang Jaya Xchange (SJX), USJ 7",
    addressLocality: "Subang Jaya",
    addressRegion: "Selangor",
    addressCountry: "MY",
  },
  containsPlace: [
    {
      "@type": "Apartment",
      name: "Type A / A-M",
      floorSize: { "@type": "QuantitativeValue", value: 730, unitCode: "FTK" },
      numberOfBedrooms: 2,
      numberOfBathroomsTotal: 2,
    },
    {
      "@type": "Apartment",
      name: "Type B / B-M",
      floorSize: { "@type": "QuantitativeValue", value: 920, unitCode: "FTK" },
      numberOfBedrooms: 3,
      numberOfBathroomsTotal: 2,
    },
  ],
};

const realEstateAgent = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: `${agent.name}, ${agency.name}`,
  description: independenceNotice,
  image: ogImage,
  url: `${site.url}/`,
  telephone: agent.phoneDisplay,
  email: agent.email,
  identifier: agent.ren,
  parentOrganization: {
    "@type": "Organization",
    name: agency.name,
    identifier: `BOVAEP ${agency.licence}`,
  },
  areaServed: "Subang Jaya, Selangor, Malaysia",
  address: {
    "@type": "PostalAddress",
    streetAddress: "1-1, PJ 21 Commercial Centre, Jalan SS3/39",
    postalCode: "47300",
    addressLocality: "Petaling Jaya",
    addressRegion: "Selangor",
    addressCountry: "MY",
  },
  knowsAbout: "USJ 7 Residences and new launch TOD homes in Subang Jaya",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAFAF9" />
    <link rel="icon" type="image/svg+xml" href="/assets/trybe-logo.svg" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- ============ SEO ============ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="USJ 7 Residences, USJ7 Residences, USJ 7 Residences Subang Jaya, USJ 7 Residences price, USJ 7 Residences floor plan, new launch condo Subang Jaya, new condo Subang Jaya 2026, new launch USJ, USJ7 condo, USJ new property, Subang Jaya Xchange, SJX Subang Jaya, SJX residences, condo near USJ7 LRT, USJ7 LRT BRT condo, TOD condo Subang Jaya, transit-oriented development Subang Jaya, condo near LRT Kelana Jaya line, condo near BRT Sunway line, condo with covered walkway to LRT, freehold service apartment Subang Jaya, freehold condo Subang Jaya, 2 bedroom condo Subang Jaya, 3 bedroom condo USJ, early bird property promotion Subang Jaya, condo near Sunway Pyramid, condo near Sunway University, condo near Monash University Malaysia, condo near Taylor's University, condo near SEGi Subang, condo near Summit USJ, condo near Subang Airport, rumah baru Subang Jaya, kondo pegangan bebas Subang Jaya, kondo dekat LRT USJ7, 梳邦再也新楼盘, 梳邦再也公寓, USJ7轻快铁公寓"
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={`${agent.name}, ${agent.ren}`} />
    <link rel="canonical" href={`${site.url}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="USJ 7 Residences, Subang Jaya" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${site.url}/`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- ============ Structured data ============ -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(apartmentComplex)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(realEstateAgent)}
    />

    <!-- ============ Speed Insights ============ -->
    <SpeedInsights />
  </head>
  <body id="top">
    <slot />

    <script>
      // Arms [data-reveal] (see global.css). Items stay visible without JS
      // or under reduced motion, because the hidden state is CSS-gated.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
