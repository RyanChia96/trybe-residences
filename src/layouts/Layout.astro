---
import "@fontsource-variable/outfit";
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import { project, agency, agent, site, independenceNotice } from "../config/site";

const title =
  "Trybe Residences Subang Jaya | New Launch TOD Condo at USJ7 LRT-BRT";
const description = `Hype 2 (Trybe) Residences Phase 2 at Subang Jaya Xchange, Subang Jaya's largest TOD township plan. Freehold 2 to 3-bedroom homes from 730 sqft, with a covered walkway to the USJ7 LRT-BRT interchange. Marketed by ${agent.name} (${agent.ren}), ${agency.name}.`;
const ogImage = `${site.url}/assets/og-image.jpg`;

const apartmentComplex = {
  "@context": "https://schema.org",
  "@type": "ApartmentComplex",
  name: project.officialName,
  alternateName: [project.name, "Hype 2 Residences"],
  description:
    "Phase 2 of a freehold service apartment at Subang Jaya Xchange (SJX), USJ7, Subang Jaya, with a covered walkway to the USJ7 LRT-BRT interchange station. 2 to 3-bedroom flexi layouts of 730 and 920 sqft with hackable walls.",
  url: `${site.url}/`,
  image: ogImage,
  numberOfBedrooms: "2-3",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Subang Jaya Xchange (SJX), USJ 7",
    addressLocality: "Subang Jaya",
    addressRegion: "Selangor",
    addressCountry: "MY",
  },
  containsPlace: [
    {
      "@type": "Apartment",
      name: "Type A / A-M",
      floorSize: { "@type": "QuantitativeValue", value: 730, unitCode: "FTK" },
      numberOfBedrooms: 2,
      numberOfBathroomsTotal: 2,
    },
    {
      "@type": "Apartment",
      name: "Type B / B-M",
      floorSize: { "@type": "QuantitativeValue", value: 920, unitCode: "FTK" },
      numberOfBedrooms: 3,
      numberOfBathroomsTotal: 2,
    },
  ],
};

const realEstateAgent = {
  "@context": "https://schema.org",
  "@type": "RealEstateAgent",
  name: `${agent.name}, ${agency.name}`,
  description: independenceNotice,
  image: ogImage,
  url: `${site.url}/`,
  telephone: agent.phoneDisplay,
  email: agent.email,
  identifier: agent.ren,
  parentOrganization: {
    "@type": "Organization",
    name: agency.name,
    identifier: `BOVAEP ${agency.licence}`,
  },
  areaServed: "Subang Jaya, Selangor, Malaysia",
  address: {
    "@type": "PostalAddress",
    streetAddress: "1-1, PJ 21 Commercial Centre, Jalan SS3/39",
    postalCode: "47300",
    addressLocality: "Petaling Jaya",
    addressRegion: "Selangor",
    addressCountry: "MY",
  },
  knowsAbout: "Trybe Residences and new launch TOD homes in Subang Jaya",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#161614" />
    <link rel="icon" type="image/svg+xml" href="/assets/pjpropertylogo.svg" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- ============ SEO ============ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Subang Jaya new launch, TOD Subang Jaya, USJ7 LRT BRT condo, freehold service apartment Subang Jaya, Trybe Residences, Hype 2 Subang Jaya, Subang Jaya Xchange, SJX, largest TOD township Subang Jaya"
    />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={`${agent.name}, ${agent.ren}`} />
    <link rel="canonical" href={`${site.url}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Trybe Residences, Subang Jaya" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${site.url}/`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- ============ Structured data ============ -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(apartmentComplex)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(realEstateAgent)}
    />

    <!-- ============ Speed Insights ============ -->
    <SpeedInsights />
  </head>
  <body id="top">
    <slot />

    <script>
      // Arms [data-reveal] (see global.css). Items stay visible without JS
      // or under reduced motion, because the hidden state is CSS-gated.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    </script>
  </body>
</html>
