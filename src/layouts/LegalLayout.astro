---
import "@fontsource-variable/outfit";
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { project, identityLine, site } from "../config/site";

interface Props {
  title: string;
  description: string;
  heading: string;
  lastUpdated: string;
  path: string;
  eyebrow?: string;
}

const {
  title,
  description,
  heading,
  lastUpdated,
  path,
  eyebrow = "Legal",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#161614" />
    <link rel="icon" type="image/svg+xml" href="/assets/trybe-logo.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={`${site.url}${path}`} />

    <SpeedInsights />
  </head>
  <body id="top">
    <div
      class="bg-surface text-fg-muted text-center text-[12px] leading-[1.5] px-gutter py-2.5"
    >
      {identityLine}
    </div>
    <header class="bg-bg border-b border-line">
      <nav
        class="max-w-wrap mx-auto px-gutter h-[72px] flex items-center justify-between gap-6"
      >
        <a href="/" class="flex items-center gap-3 flex-none">
          <img
            src="/assets/trybe-logo.svg"
            alt={project.name}
            width="40"
            height="40"
            class="w-10 h-10 flex-none"
          />
          <span class="flex flex-col leading-none">
            <span class="text-[21px] font-semibold tracking-[0.22em]"
              >{project.wordmarkTop}</span
            >
            <span
              class="hidden sm:block text-[10px] tracking-[0.3em] text-fg-subtle font-medium mt-1"
              >{project.wordmarkBottom}</span
            >
          </span>
        </a>
        <a
          href="/"
          class="text-[15px] font-medium text-fg-muted transition-colors duration-200 hover:text-fg"
          >&larr; Back to home</a
        >
      </nav>
    </header>

    <main class="max-w-wrap mx-auto px-gutter py-[clamp(56px,8vw,104px)]">
      <div class="max-w-[760px] mx-auto">
        <p class="text-[13px] tracking-[0.2em] uppercase text-accent font-semibold mb-5">
          {eyebrow}
        </p>
        <h1
          class="font-semibold text-[clamp(36px,5vw,56px)] leading-[1.05] tracking-[-0.02em] mb-4"
        >
          {heading}
        </h1>
        <p class="text-[14px] text-fg-subtle mb-[clamp(36px,5vw,56px)]">
          Last updated: {lastUpdated}
        </p>

        <div
          class="flex flex-col gap-[clamp(28px,4vw,40px)] text-[16px] leading-[1.75] text-fg-muted [&_h2]:text-[24px] [&_h2]:font-semibold [&_h2]:text-fg [&_h2]:mb-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:flex [&_ul]:flex-col [&_ul]:gap-2 [&_a]:text-fg [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-accent"
        >
          <slot />
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
