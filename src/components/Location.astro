---
import { Icon } from "astro-icon/components";
import ImageSlot from "./ImageSlot.astro";

// Rail lines reachable from the USJ7 interchange, from the developer's
// connectivity board. Built as markup, not an image, so it stays legible.
const lines = [
  {
    name: "LRT Kelana Jaya Line",
    dot: "bg-accent",
    rail: "bg-accent",
    stops: [
      { code: "KJ29", name: "SS15", note: "SS15 Courtyard, INTI International" },
      { code: "KJ19", name: "University", note: "MAHSA, Taylor's University" },
      { code: "KJ15", name: "KL Sentral", note: "ETS, KLIA Express, MRT, KTM" },
      { code: "KJ10", name: "KLCC", note: "Suria KLCC, Petronas Twin Towers" },
    ],
  },
  {
    name: "BRT Sunway Line",
    dot: "bg-olive",
    rail: "bg-olive",
    stops: [
      { code: "SB5", name: "SunU-Monash", note: "Monash, Sunway University" },
      { code: "SB4", name: "SunMed", note: "Sunway Medical, Taylor's College" },
      { code: "SB3", name: "Sunway Lagoon", note: "Sunway Pyramid, Sunway Lagoon" },
      { code: "SB1", name: "Sunway-Setia Jaya", note: "The One Academy" },
    ],
  },
];

const groups = [
  {
    id: "transport",
    title: "Transport",
    icon: "ph:train-simple",
    items: [
      ["400m", "USJ7 LRT-BRT Interchange Station"],
      ["400m", "USJ Taipan Station"],
      ["6.4km", "Subang Jaya LRT-KTM Interchange Station"],
      ["10.7km", "Subang Airport"],
    ],
  },
  {
    id: "retail",
    title: "Retail",
    icon: "ph:shopping-bag",
    items: [
      ["350m", "SJ7 (upcoming collaboration hub)"],
      ["750m", "Easyhome Mall (Da Men Mall)"],
      ["1.3km", "Taipan USJ"],
      ["2.0km", "Summit USJ"],
      ["2.2km", "Mydin Hypermarket USJ1"],
    ],
  },
  {
    id: "health",
    title: "Health and safety",
    icon: "ph:shield-check",
    items: [
      ["950m", "QHC Medical Centre"],
      ["1.0km", "Subang Jaya District Police HQ"],
      ["1.1km", "OSC Orthopaedic Specialist Centre"],
      ["1.5km", "Taipan Police Station"],
      ["5.0km", "Subang Jaya Medical Centre (SJMC)"],
      ["5.6km", "Sunway Medical Centre"],
    ],
  },
  {
    id: "sports",
    title: "Sports",
    icon: "ph:soccer-ball",
    items: [
      ["1.2km", "Pickle Haven USJ"],
      ["1.3km", "USJ1 Public Park and basketball court"],
      ["1.8km", "Forum Optimum Badminton Centre"],
      ["1.9km", "Kompleks 3K Subang Jaya"],
      ["1.9km", "Lavana 2 Sports Centre (Subang)"],
      ["2.0km", "91 Sports Arena"],
      ["2.9km", "Republic of Futsal Subang Elite"],
    ],
  },
  {
    id: "education",
    title: "Education",
    icon: "ph:graduation-cap",
    items: [
      ["1.2km", "Cilantro Culinary Academy"],
      ["1.2km", "ANIBT Malaysia Campus"],
      ["1.3km", "International Medical College (IMC)"],
      ["1.7km", "Water Mates Swimming Academy"],
      ["2.1km", "SEGi University and Colleges"],
      ["2.1km", "Tech Terrain College"],
      ["2.6km", "Monash University Malaysia"],
    ],
  },
  {
    id: "business",
    title: "Business",
    icon: "ph:briefcase",
    items: [
      ["1.1km", "Subang Business Centre"],
      ["1.6km", "Taipan Business Centre"],
      ["2.1km", "Subang Jaya City Council"],
    ],
  },
];
---

<section id="location" class="py-16 lg:py-24 px-gutter bg-surface">
  <div class="max-w-wrap mx-auto">
    <div class="max-w-[720px] mb-10 lg:mb-14" data-reveal>
      <h2 class="text-[clamp(32px,4vw,52px)] font-semibold leading-[1.05] tracking-[-0.02em]">
        On the line to KL Sentral and Sunway
      </h2>
      <p class="mt-4 text-[17px] leading-[1.6] text-fg-muted max-w-[56ch]">
        USJ7 is an interchange: board the Kelana Jaya LRT towards KLCC, or the
        Sunway BRT towards Sunway Pyramid, from one station.
      </p>
    </div>

    <!-- Rail diagram: horizontal on desktop, vertical on mobile -->
    <div class="flex flex-col gap-10 lg:gap-12 mb-16 lg:mb-20">
      {
        lines.map((line) => (
          <div data-reveal>
            <p class="text-[15px] font-semibold mb-5 flex items-center gap-2.5">
              <span class:list={["inline-block w-3.5 h-3.5 rounded-full", line.dot]} aria-hidden="true" />
              {line.name}
            </p>
            <ol class="relative grid gap-6 md:grid-cols-4 md:gap-4 pl-7 md:pl-0">
              <span
                class:list={["absolute left-[6px] top-2 bottom-2 w-[3px] md:left-0 md:right-0 md:top-[6px] md:bottom-auto md:w-auto md:h-[3px]", line.rail]}
                aria-hidden="true"
              />
              {line.stops.map((s) => (
                <li class="relative md:pt-8">
                  <span
                    class="absolute -left-7 top-1 md:left-0 md:top-0 w-[15px] h-[15px] rounded-full bg-bg border-[3px] border-fg"
                    aria-hidden="true"
                  />
                  <p class="text-[13px] font-semibold text-fg-subtle tracking-[0.04em]">{s.code}</p>
                  <p class="text-[19px] font-semibold leading-[1.2] mt-0.5">{s.name}</p>
                  <p class="text-[14px] leading-[1.5] text-fg-muted mt-1">{s.note}</p>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>

    <!-- Map + nearby places in tabs -->
    <div class="grid gap-10 lg:gap-14 lg:grid-cols-[1.1fr_1fr] items-start">
      <ImageSlot
        alt="Location map of Trybe Residences beside USJ7 Station, between KESAS, LDP and Puchong"
        ratio="4/3"
        need="location map (Subang Jaya, USJ7 Station, KESAS, LDP), 1600x1200"
        tiles={["t-lattice", "t-circle", "t-arcs", "t-quarter"]}
        cols={4}
        impression={false}
      />

      <div data-reveal>
        <h3 class="text-[26px] font-semibold leading-[1.15] mb-5">Close to home</h3>
        <div role="tablist" aria-label="Nearby places" class="flex flex-wrap gap-2 mb-7">
          {
            groups.map((g, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${g.id}`}
                aria-controls={`panel-${g.id}`}
                aria-selected={i === 0 ? "true" : "false"}
                tabindex={i === 0 ? 0 : -1}
                data-tab
                class="inline-flex items-center gap-2 px-4 py-2.5 text-[14px] font-medium border border-line-strong text-fg-muted transition-colors duration-200 hover:text-fg aria-selected:bg-fg aria-selected:text-bg aria-selected:border-fg"
              >
                <Icon name={g.icon} class="w-4 h-4" aria-hidden="true" />
                {g.title}
              </button>
            ))
          }
        </div>
        {
          groups.map((g, i) => (
            <ul
              role="tabpanel"
              id={`panel-${g.id}`}
              aria-labelledby={`tab-${g.id}`}
              hidden={i !== 0}
              class="grid gap-4"
            >
              {g.items.map(([dist, name]) => (
                <li class="grid grid-cols-[84px_1fr] items-baseline gap-4">
                  <span class="text-[20px] font-semibold text-accent tabular-nums">{dist}</span>
                  <span class="text-[16px] leading-[1.45]">{name}</span>
                </li>
              ))}
            </ul>
          ))
        }
        <p class="mt-8 text-[13px] text-fg-subtle">
          Distances are approximate and for reference only.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-tab]"));
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute("aria-controls")!);
      if (panel) panel.hidden = !on;
    }
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(tab));
    tab.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>
