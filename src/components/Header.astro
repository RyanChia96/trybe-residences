---
import { project, identityLine, ctaLabel } from "../config/site";

const links = [
  { href: "#signature", label: "Why Trybe" },
  { href: "#residences", label: "Layouts" },
  { href: "#location", label: "Location" },
  { href: "#faq", label: "FAQ" },
];
---

<!-- Advertiser identity, stated before anything else on the page. -->
<div
  class="bg-surface text-fg-muted text-center text-[12px] leading-[1.5] px-gutter py-2.5"
>
  {identityLine}
</div>

<header class="sticky top-0 z-header bg-bg/90 backdrop-blur-md border-b border-line">
  <nav
    class="max-w-wrap mx-auto px-gutter h-[72px] flex items-center justify-between gap-6"
  >
    <a href="#top" class="flex items-center gap-3 flex-none">
      <img
        src="/assets/pjpropertylogo.svg"
        alt={project.name}
        width="40"
        height="40"
        class="w-10 h-10 flex-none"
      />
      <span class="flex flex-col leading-none">
        <span class="text-[21px] font-semibold tracking-[0.22em]">{project.wordmarkTop}</span>
        <span class="hidden sm:block text-[10px] tracking-[0.3em] text-fg-subtle font-medium mt-1"
          >{project.wordmarkBottom}</span
        >
      </span>
    </a>
    <div class="flex items-center gap-[clamp(20px,2.6vw,40px)] text-[15px] font-medium">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="hidden lg:inline text-fg-muted transition-colors duration-200 hover:text-fg"
          >
            {l.label}
          </a>
        ))
      }
      <a href="#register" class="btn-primary !px-5 !py-3 !text-[14px]">{ctaLabel}</a>
    </div>
  </nav>
</header>
