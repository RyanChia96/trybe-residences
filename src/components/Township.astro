---
import { Icon } from "astro-icon/components";
import ImageSlot from "./ImageSlot.astro";

const points = [
  {
    icon: "ph:storefront",
    title: "Retail and dining",
    body: "A lifestyle destination planned with shops, cafes and restaurants.",
  },
  {
    icon: "ph:tree",
    title: "Green public spaces",
    body: "Landscaped areas for relaxing, events and community life.",
  },
  {
    icon: "ph:person-simple-walk",
    title: "Pedestrian links",
    body: "Direct connections to shops, offices, homes and public transport.",
  },
];
---

<section id="township" class="py-16 lg:py-24">
  <div class="px-gutter">
    <div class="max-w-wrap mx-auto mb-10 lg:mb-14" data-reveal>
      <h2 class="text-[clamp(32px,4vw,52px)] font-semibold leading-[1.05] tracking-[-0.02em] max-w-[18ch]">
        Subang Jaya Xchange, a work, live and play hub
      </h2>
      <p class="mt-4 text-[17px] leading-[1.6] text-fg-muted max-w-[56ch]">
        Trybe sits inside SJX, an integrated development planned around
        retail, green space and walkable streets in the heart of Subang Jaya.
      </p>
    </div>
  </div>

  <!-- Kept within the content width so the 2000px render is never upscaled. -->
  <div class="px-gutter">
  <ImageSlot
    src="/assets/sjx-streetscape.webp"
    alt="Subang Jaya Xchange streetscape with cafes, trees and a landscaped walkway"
    ratio="16/9"
    fit="contain"
    need="SJX streetscape, 2000x1125, no text"
    tiles={["t-leaf", "t-arcs", "t-circle", "t-stripes", "t-dots", "t-quarter", "t-split", "t-moon", "t-lattice", "t-half", "t-hstripes", "t-leaf"]}
    cols={12}
    class="max-w-wrap mx-auto"
  />
  </div>

  <div class="px-gutter">
    <ul class="max-w-wrap mx-auto mt-10 lg:mt-14 grid gap-10 md:grid-cols-[1.3fr_1fr_1fr]">
      {
        points.map((p, i) => (
          <li class="flex gap-4" data-reveal style={`--i:${i}`}>
            <Icon name={p.icon} class="w-7 h-7 text-accent flex-none mt-0.5" aria-hidden="true" />
            <div>
              <h3 class="text-[20px] font-semibold leading-[1.2]">{p.title}</h3>
              <p class="mt-2 text-[15.5px] leading-[1.6] text-fg-muted max-w-[34ch]">{p.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
