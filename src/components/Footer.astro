---
import PatternBand from "./PatternBand.astro";
import {
  project,
  agency,
  agent,
  independenceNotice,
  permitNotice,
  materialsNotice,
} from "../config/site";

const year = new Date().getFullYear();
---

<footer class="bg-bg text-fg">
  <PatternBand />
  <div class="px-gutter pt-[clamp(64px,8vw,104px)] pb-11">
  <div class="max-w-wrap mx-auto">
    <div
      class="flex flex-col md:flex-row md:items-start md:justify-between gap-12 pb-[40px]"
    >
      <div class="max-w-[40ch]">
        <div class="flex items-center gap-[13px] flex-none mb-[22px]">
          <img
            src="/assets/trybe-logo.svg"
            alt={project.name}
            width="40"
            height="40"
            class="w-10 h-10 flex-none"
          />
          <span class="flex flex-col leading-none">
            <span
              class="text-[21px] font-semibold tracking-[0.22em]"
              >{project.wordmarkTop}</span
            >
            <span
              class="text-[10px] tracking-[0.3em] text-fg-subtle font-medium mt-1"
              >{project.wordmarkBottom}</span
            >
          </span>
        </div>
        <p class="text-[15px] leading-[1.7] text-fg-muted">
          Phase 2 of a freehold TOD service apartment at Subang Jaya Xchange,
          USJ7, Subang Jaya.
        </p>
      </div>
      <div>
        <h4
          class="text-[13px] tracking-[0.12em] uppercase text-fg-subtle font-bold mb-[18px]"
        >
          Explore
        </h4>
        <ul
          class="list-none flex flex-col gap-3 text-[15px] text-fg-muted whitespace-nowrap"
        >
          <li>
            <a
              href="#signature"
              class="transition-colors duration-200 hover:text-accent"
              >Why Trybe</a
            >
          </li>
          <li>
            <a
              href="#residences"
              class="transition-colors duration-200 hover:text-accent">Layouts</a
            >
          </li>
          <li>
            <a
              href="#location"
              class="transition-colors duration-200 hover:text-accent"
              >Location</a
            >
          </li>
          <li>
            <a href="#faq" class="transition-colors duration-200 hover:text-accent"
              >FAQ</a
            >
          </li>
          <li>
            <a
              href="#register"
              class="transition-colors duration-200 hover:text-accent">Register Interest</a
            >
          </li>
        </ul>
      </div>
      <div>
        <h4
          class="text-[13px] tracking-[0.12em] uppercase text-fg-subtle font-bold mb-[18px]"
        >
          Marketed by
        </h4>
        <ul
          class="list-none flex flex-col gap-2 text-[15px] text-fg-muted max-w-[34ch]"
        >
          <li>{agent.name} · {agent.ren}</li>
          <li class="text-fg-subtle">
            {agency.name}{agency.companyNo ? ` (${agency.companyNo})` : ""}
          </li>
          <li class="text-fg-subtle">
            Registered Estate Agency, BOVAEP {agency.licence}
          </li>
          <li class="text-fg-subtle leading-[1.6] pt-1">
            {agency.address}
          </li>
          <li class="pt-1">
            <a
              href={`tel:${agent.phoneHref}`}
              class="transition-colors duration-200 hover:text-accent"
              >{agent.phoneDisplay}</a
            >
          </li>
          <li>
            <a
              href={`mailto:${agent.email}`}
              class="transition-colors duration-200 hover:text-accent"
              >{agent.email}</a
            >
          </li>
          <li class="pt-1">
            <a
              href="https://lpeph.gov.my/search-listing"
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="underline underline-offset-2 text-fg-subtle transition-colors duration-200 hover:text-accent"
              >Verify on the BOVAEP register</a
            >
          </li>
        </ul>
      </div>
      <div class="max-w-[46ch]">
        <h4
          class="text-[13px] tracking-[0.12em] uppercase text-fg-subtle font-bold mb-[18px]"
        >
          Project governance
        </h4>
        <p
          class="text-[13px] leading-[1.7] text-fg-subtle mb-3"
        >
          This site markets Phase 2 of Hype 2 (Trybe) Residences at Subang Jaya
          Xchange, USJ7, Subang Jaya.<br />{permitNotice}
        </p>
        <p class="text-[13px] leading-[1.7] text-fg-subtle">
          {materialsNotice}
        </p>
      </div>
    </div>

    <!-- The single most important line on the page for ad review: who this
         site is, and who it is not. -->
    <div
      class="border-t border-line pt-8 pb-2 text-[13px] leading-[1.75] text-fg-subtle max-w-[92ch]"
    >
      <span
        class="text-[12px] tracking-[0.12em] uppercase font-bold text-fg-subtle block mb-2"
        >Independent agency disclaimer</span
      >
      {independenceNotice}
    </div>

    <div
      class="flex flex-wrap gap-3.5 justify-center md:justify-between items-center border-t border-line text-[13px] text-fg-subtle py-[32px] mt-6"
    >
      <span
        >© {year} {agent.name}, {agency.name}. Not the official developer
        website.</span
      >
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a
          href="/about"
          class="transition-colors duration-200 hover:text-accent underline"
          >About</a
        >
        <a
          href="/terms"
          class="transition-colors duration-200 hover:text-accent underline"
          >Terms of Use</a
        >
        <a
          href="/privacy"
          class="transition-colors duration-200 hover:text-accent underline"
          >Privacy Policy</a
        >
      </div>
    </div>
  </div>
  </div>
</footer>
