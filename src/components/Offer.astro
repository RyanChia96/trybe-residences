---
import { Icon } from "astro-icon/components";
import { ctaLabel, registerMessage, waLink } from "../config/site";
---

<!-- The saving is the message, so the figure carries the section at display
     size; the copy and CTA sit beside it. -->
<section id="offer" class="py-16 lg:py-24 px-gutter border-y border-line">
  <div class="max-w-wrap mx-auto grid gap-8 lg:gap-16 lg:grid-cols-[1.2fr_1fr] items-center" data-reveal>
    <div>
      <p class="text-[13px] font-semibold uppercase tracking-[0.2em] text-accent mb-3">
        Phase 1 100% sold
      </p>
      <p class="text-[clamp(22px,2.4vw,32px)] font-semibold leading-[1.1]">Early birds save up to</p>
      <p
        class="text-[clamp(96px,15vw,216px)] font-semibold leading-[0.9] tracking-[-0.05em] text-accent"
        aria-label="RM80K"
      >
        RM80K
      </p>
    </div>
    <div class="flex flex-col items-start gap-6">
      <h2 class="text-[clamp(28px,3vw,40px)] font-semibold leading-[1.1] tracking-[-0.015em]">
        Reserved for the first 50 purchasers in Phase 2
      </h2>
      <p class="text-[17px] leading-[1.6] text-fg-muted max-w-[46ch]">
        Offer terms, eligibility and the amount for each unit are set and
        confirmed by the developer at booking.
      </p>
      <a
        href={waLink(registerMessage)}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="btn-primary"
      >
        <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 text-white" aria-hidden="true" />
        {ctaLabel}
      </a>
    </div>
  </div>
</section>
