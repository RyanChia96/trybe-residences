---
import { Icon } from "astro-icon/components";
import { ctaLabel, registerMessage, waLink } from "../config/site";
---

<!-- The render has a transparent sky, so the towers rise straight out of the
     page and the copy sits in the open sky to their left. On desktop the image
     is nudged right (and cropped) to widen that sky; the copy never overlaps
     the towers. On mobile the copy stacks above a tighter crop. -->
<section id="hero-media" class="relative overflow-hidden">
  <div class="relative z-[1] max-w-wrap mx-auto px-gutter pt-10 xl:pt-14 xl:absolute xl:inset-x-0 xl:top-0">
    <div class="flex flex-col items-start gap-6 xl:max-w-[min(36vw,560px)] hero-in">
      <p class="text-[13px] font-semibold uppercase tracking-[0.2em] text-fg-subtle">
        USJ 7 Residences · Phase 2 now launching
      </p>
      <h1 class="text-[clamp(42px,4.7vw,76px)] font-semibold leading-[0.98] tracking-[-0.035em]">
        <span class="block whitespace-nowrap">Subang Jaya's</span><span class="block whitespace-nowrap text-accent">new beat.</span>
      </h1>
      <p class="text-[clamp(16px,1.25vw,19px)] leading-[1.6] text-fg-muted max-w-[38ch]">
        Freehold 2 and 3-bedroom homes at Subang Jaya Xchange, walkway-linked
        to <span class="whitespace-nowrap">USJ7 LRT-BRT.</span>
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a
          href={waLink(registerMessage)}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="btn-primary"
        >
          <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 text-white" aria-hidden="true" />
          {ctaLabel}
        </a>
        <a href="#residences" class="btn-ghost bg-bg/70">
          View Layouts
          <Icon name="ph:arrow-right" class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>

  <figure class="relative mt-6 xl:mt-0">
    <div class="max-xl:aspect-[4/5] max-xl:overflow-hidden sm:max-xl:aspect-[16/11]">
      <img
        src="/assets/hero-towers-sky.webp"
        alt="USJ 7 Residences, two freehold towers at Subang Jaya Xchange near USJ7 LRT, rising above a landscaped garden"
        width="2000"
        height="1125"
        fetchpriority="high"
        decoding="async"
        class="block max-xl:h-full max-xl:w-full max-xl:object-cover max-xl:object-[52%_100%] xl:w-full xl:max-w-[2000px] xl:ml-[16%] xl:[mask-image:linear-gradient(to_right,transparent,#000_20%)] hero-rise"
      />
    </div>
    <figcaption class="absolute right-gutter bottom-4 text-[12px] text-white [text-shadow:0_1px_6px_rgba(22,22,20,0.6)]">
      Artist's impression
    </figcaption>
  </figure>
</section>
