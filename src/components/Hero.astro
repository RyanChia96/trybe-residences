---
import { Icon } from "astro-icon/components";
import ImageSlot from "./ImageSlot.astro";
import PatternBand from "./PatternBand.astro";
import { ctaLabel, registerMessage, waLink } from "../config/site";
---

<section id="hero-media" class="relative">
  <div
    class="max-w-wrap mx-auto px-gutter pt-12 pb-14 lg:pt-16 lg:pb-16 grid gap-10 lg:gap-16 lg:grid-cols-[1.05fr_1fr] items-center lg:min-h-[calc(100dvh-216px)]"
  >
    <div class="flex flex-col items-start gap-7 hero-in">
      <p class="text-[13px] font-semibold uppercase tracking-[0.2em] text-accent">
        Trybe Residences · Phase 2 now launching
      </p>
      <h1
        class="text-[clamp(44px,6.2vw,88px)] font-semibold leading-[1] tracking-[-0.03em]"
      >
        Subang Jaya's<br /><span class="text-accent">new beat.</span>
      </h1>
      <p class="text-[clamp(17px,1.5vw,20px)] leading-[1.55] text-fg-muted max-w-[46ch]">
        Freehold 2 and 3-bedroom homes at Subang Jaya Xchange, the largest TOD
        township plan, walkway-linked to <span class="whitespace-nowrap">USJ7 LRT-BRT.</span>
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a
          href={waLink(registerMessage)}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="btn-primary"
        >
          <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5" aria-hidden="true" />
          {ctaLabel}
        </a>
        <a href="#residences" class="btn-ghost">
          View Layouts
          <Icon name="ph:arrow-right" class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <ImageSlot
      alt="Hype 2 (Trybe) Residences towers and guardhouse at Subang Jaya Xchange at sunset"
      ratio="5/4"
      need="hero render of the two towers, 1600x1280, no text"
      tiles={["t-quarter", "t-circle", "t-stripes", "t-leaf", "t-arcs", "t-split", "t-moon", "t-half", "t-dots", "t-lattice"]}
      cols={5}
      eager
    />
  </div>
  <PatternBand moving />
</section>
