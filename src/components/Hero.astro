---
import { Icon } from "astro-icon/components";
import { ctaLabel, registerMessage, waLink } from "../config/site";
---

<!-- Split hero: copy on the light page at left, the towers render on the
     right as a rounded panel. Calm and editorial rather than full-bleed. -->
<section id="hero-media" class="px-gutter pt-8 pb-16 lg:pt-12 lg:pb-24">
  <div
    class="max-w-wrap mx-auto grid gap-10 lg:gap-16 lg:grid-cols-[1fr_1.05fr] items-center"
  >
    <div class="flex flex-col items-start gap-7 hero-in max-lg:order-2">
      <p class="text-[13px] font-semibold uppercase tracking-[0.2em] text-fg-subtle">
        USJ 7 Residences · Phase 2 now launching
      </p>
      <h1 class="text-[clamp(44px,6vw,92px)] font-semibold leading-[0.98] tracking-[-0.035em]">
        <span class="block whitespace-nowrap">Subang Jaya's</span><span class="block whitespace-nowrap text-accent">new beat.</span>
      </h1>
      <p class="text-[clamp(17px,1.4vw,20px)] leading-[1.6] text-fg-muted max-w-[42ch]">
        Freehold 2 and 3-bedroom homes at Subang Jaya Xchange, the largest TOD
        township plan, walkway-linked to <span class="whitespace-nowrap">USJ7 LRT-BRT.</span>
      </p>
      <div class="flex flex-wrap gap-3 pt-1">
        <a
          href={waLink(registerMessage)}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="btn-primary"
        >
          <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 text-white" aria-hidden="true" />
          {ctaLabel}
        </a>
        <a href="#residences" class="btn-ghost">
          View Layouts
          <Icon name="ph:arrow-right" class="w-4 h-4" aria-hidden="true" />
        </a>
      </div>
    </div>

    <figure class="relative max-lg:order-1 hero-in" style="--i:1">
      <div class="overflow-hidden rounded-[28px] lg:rounded-[36px] aspect-[4/3] lg:aspect-auto lg:h-[clamp(520px,calc(100dvh-200px),720px)] bg-surface-2">
        <img
          src="/assets/hero-towers.webp"
          alt="USJ 7 Residences, a new launch freehold condo at Subang Jaya Xchange near USJ7 LRT, at sunset"
          width="2000"
          height="1125"
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover object-[62%_50%] hero-zoom"
        />
      </div>
      <figcaption class="absolute left-4 bottom-4 rounded-full bg-black/45 backdrop-blur-sm px-3 py-1 text-[12px] text-white">
        Artist's impression
      </figcaption>
    </figure>
  </div>
</section>
