---
import { Icon } from "astro-icon/components";
import { ctaLabel, registerMessage, waLink } from "../config/site";
---

<!-- Full-bleed dusk render. The towers sit on the right and the deep-blue sky
     on the left carries the copy, so the text here is white. A light scrim
     (left on desktop, top on mobile) keeps it at contrast where the sky
     brightens or the towers cross behind it. -->
<section id="hero-media" class="relative overflow-hidden bg-[#1d3260]">
  <div class="relative min-h-[max(600px,calc(100dvh-112px))] flex items-start lg:items-center">
    <img
      src="/assets/hero-dusk.webp"
      alt="USJ 7 Residences, two freehold towers with green facades and a curved drop-off canopy at Subang Jaya Xchange near USJ 7 LRT, at dusk"
      width="2000"
      height="1125"
      fetchpriority="high"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-[72%_100%] lg:object-[60%_100%] hero-zoom"
    />
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(14,27,58,0.82)_0%,rgba(14,27,58,0.55)_45%,rgba(14,27,58,0)_70%)] lg:bg-[linear-gradient(90deg,rgba(14,27,58,0.6)_0%,rgba(14,27,58,0.3)_35%,rgba(14,27,58,0)_55%)]"
      aria-hidden="true"
    ></div>

    <div class="relative w-full max-w-wrap mx-auto px-gutter pt-12 pb-16 lg:py-20 text-white">
      <div class="flex flex-col items-start gap-6 lg:max-w-[min(44vw,600px)] hero-in">
        <p class="text-[13px] font-semibold uppercase tracking-[0.2em] text-white/80">
          USJ 7 Residences · Phase 2 now launching
        </p>
        <h1 class="text-[clamp(42px,5vw,80px)] font-semibold leading-[0.98] tracking-[-0.035em]">
          <span class="block whitespace-nowrap">Subang Jaya's</span><span class="block whitespace-nowrap text-accent-bright">new beat.</span>
        </h1>
        <p class="text-[clamp(16px,1.3vw,19px)] leading-[1.6] text-white/90 max-w-[38ch]">
          Freehold 2 and 3-bedroom homes at Subang Jaya Xchange, walkway-linked
          to <span class="whitespace-nowrap">USJ 7 LRT-BRT.</span>
        </p>
        <div class="flex flex-wrap gap-3 pt-1">
          <a
            href={waLink(registerMessage)}
            target="_blank"
            rel="nofollow noopener noreferrer"
            class="btn-primary"
          >
            <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 text-white" aria-hidden="true" />
            {ctaLabel}
          </a>
          <a href="#residences" class="btn border border-white/60 text-white hover:border-white hover:bg-white/10">
            View Layouts
            <Icon name="ph:arrow-right" class="w-4 h-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>

    <p class="absolute right-gutter bottom-4 text-[12px] text-white/80">Artist's impression</p>
  </div>
</section>
