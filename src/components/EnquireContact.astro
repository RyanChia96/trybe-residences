---
import { Icon } from "astro-icon/components";
import { project, agency, agent, waLink, ctaLabel, registerMessage } from "../config/site";

const enquiries = [
  {
    label: "Floor plans and layouts",
    msg: `Hi Chloe, please send me the floor plans for ${project.name}.`,
  },
  {
    label: "Indicative pricing",
    msg: `Hi Chloe, could you share indicative pricing for ${project.name} Phase 2?`,
  },
  {
    label: "Early bird offer and availability",
    msg: `Hi Chloe, is the early bird offer for ${project.name} Phase 2 still available?`,
  },
];
---

<section id="register" class="py-16 lg:py-24 px-gutter bg-surface">
  <div class="max-w-wrap mx-auto grid gap-12 lg:gap-20 lg:grid-cols-2 items-start">
    <div data-reveal>
      <h2 class="text-[clamp(28px,3vw,40px)] font-semibold leading-[1.1] tracking-[-0.015em] mb-8">
        Your contact
      </h2>
      <div class="p-7 bg-bg border border-line">
        <div class="flex items-center gap-5">
          <span
            class="w-16 h-16 rounded-full bg-olive text-bg flex items-center justify-center flex-none text-[24px] font-semibold"
            aria-hidden="true">CT</span
          >
          <div>
            <p class="text-[22px] font-semibold leading-[1.1]">{agent.name}</p>
            <p class="text-[14px] text-fg-muted mt-1">{agent.ren} · {agent.role}</p>
          </div>
        </div>

        <dl class="mt-6 pt-6 border-t border-line text-[15px] leading-[1.6] flex flex-col gap-4">
          <div>
            <dt class="text-[13px] text-fg-subtle">Agency</dt>
            <dd>{agency.name}, Registered Estate Agency, BOVAEP {agency.licence}</dd>
          </div>
          <div>
            <dt class="text-[13px] text-fg-subtle">Office</dt>
            <dd class="text-fg-muted">{agency.address}</dd>
          </div>
          <div>
            <dt class="text-[13px] text-fg-subtle">Reach us</dt>
            <dd class="flex flex-wrap gap-x-6 gap-y-2 mt-1">
              <a href={`tel:${agent.phoneHref}`} class="inline-flex items-center gap-2 font-medium hover:text-accent transition-colors duration-200">
                <Icon name="ph:phone" class="w-4 h-4" aria-hidden="true" />{agent.phoneDisplay}
              </a>
              <a href={`mailto:${agent.email}`} class="inline-flex items-center gap-2 font-medium hover:text-accent transition-colors duration-200">
                <Icon name="ph:envelope-simple" class="w-4 h-4" aria-hidden="true" />{agent.email}
              </a>
            </dd>
          </div>
        </dl>
      </div>
    </div>

    <div data-reveal style="--i:1">
      <h2 class="text-[clamp(28px,3vw,40px)] font-semibold leading-[1.1] tracking-[-0.015em] mb-8">
        What would you like to know?
      </h2>
      <div class="flex flex-col gap-3">
        {
          enquiries.map((e) => (
            <a
              href={waLink(e.msg)}
              target="_blank"
              rel="nofollow noopener noreferrer"
              class="flex items-center justify-between gap-4 border border-line-strong px-6 py-5 text-[16px] font-medium transition-colors duration-200 hover:border-accent"
            >
              {e.label}
              <Icon name="ph:arrow-up-right" class="w-5 h-5 text-accent flex-none" aria-hidden="true" />
            </a>
          ))
        }
        <a
          href={waLink(registerMessage)}
          target="_blank"
          rel="nofollow noopener noreferrer"
          class="btn-primary mt-3"
        >
          <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5" aria-hidden="true" />
          {ctaLabel}
        </a>
      </div>
      <p class="text-[13px] text-fg-subtle leading-[1.6] mt-5">
        This website does not collect your details through a form. When you
        message us on WhatsApp, you consent to being contacted by {agent.name}
        ({agent.ren}) of {agency.name} regarding {project.name}. See our <a
          href="/privacy"
          class="underline underline-offset-2 hover:text-accent">Privacy Policy</a
        >. You may ask us to stop contacting you at any time.
      </p>
    </div>
  </div>
</section>
