---
// An image at a fixed aspect ratio, so the layout does not shift while it
// loads. Without `src` it renders a plain surface panel and a TODO comment,
// so a missing image is obvious in review but never breaks the layout.
interface Props {
  src?: string;
  alt: string;
  ratio: string; // e.g. "4/5"
  need: string; // what the missing image should be, for the TODO list
  impression?: boolean;
  eager?: boolean;
  fit?: "cover" | "contain";
  class?: string;
}
const {
  src,
  alt,
  ratio,
  need,
  impression = true,
  eager = false,
  fit = "cover",
  class: cls,
} = Astro.props;
---

<figure class:list={["flex flex-col gap-2.5", cls]}>
  {
    src ? (
      <img
        src={src}
        alt={alt}
        loading={eager ? "eager" : "lazy"}
        fetchpriority={eager ? "high" : undefined}
        decoding="async"
        class:list={["w-full h-auto", fit === "contain" ? "object-contain" : "object-cover"]}
        style={`aspect-ratio:${ratio}`}
      />
    ) : (
      <>
        <Fragment set:html={`<!-- TODO image: ${need} -->`} />
        <div role="img" aria-label={alt} class="w-full bg-surface-2" style={`aspect-ratio:${ratio}`} />
      </>
    )
  }
  {
    src && impression && (
      <figcaption class="text-[12px] text-fg-subtle">Artist's impression</figcaption>
    )
  }
</figure>
