---
import { Icon } from "astro-icon/components";
import ImageSlot from "./ImageSlot.astro";
import { ctaLabel, registerMessage, waLink } from "../config/site";

const units = [
  {
    name: "Type A / A-M",
    size: "730",
    beds: "2 bedrooms",
    baths: "2 bathrooms",
    parking: "1 to 2 car park bays",
    plan: "/assets/floorplan-type-a-blur.webp",
    tiles: ["t-quarter", "t-dots", "t-leaf", "t-split"],
  },
  {
    name: "Type B / B-M",
    size: "920",
    beds: "3 bedrooms",
    baths: "2 bathrooms",
    parking: "2 car park bays",
    plan: "/assets/floorplan-type-b-blur.webp",
    tiles: ["t-circle", "t-lattice", "t-moon", "t-stripes"],
  },
];
---

<section id="residences" class="py-16 lg:py-24 px-gutter">
  <div class="max-w-wrap mx-auto">
    <div class="max-w-[720px] mb-10 lg:mb-14" data-reveal>
      <h2 class="text-[clamp(32px,4vw,52px)] font-semibold leading-[1.05] tracking-[-0.02em]">
        Two layouts, both with a hackable wall
      </h2>
      <p class="mt-4 text-[17px] leading-[1.6] text-fg-muted max-w-[56ch]">
        Remove the marked wall to open the living hall, or keep it for an
        extra room. Your call, after handover.
      </p>
    </div>

    <div class="grid gap-3 md:grid-cols-2">
      {
        units.map((u, i) => (
          <article class="bg-surface flex flex-col" data-reveal style={`--i:${i}`}>
            <div class="p-5 lg:p-6 bg-fg/[0.04]">
              {/* Plans are published pre-blurred; the sharp version is shared on enquiry. */}
              <ImageSlot
                src={u.plan}
                alt={`${u.name} floor plan preview, ${u.size} sqft (blurred, full plan on request)`}
                ratio="8/5"
                need={`${u.name} floor plan, 1600x1200`}
                tiles={u.tiles}
                cols={4}
                impression={false}
              />
            </div>
            <div class="p-7 lg:p-9 flex flex-col gap-6">
              <div class="flex flex-wrap items-end justify-between gap-4">
                <h3 class="text-[28px] font-semibold leading-none">{u.name}</h3>
                <p class="leading-none">
                  <span class="text-[clamp(44px,5vw,64px)] font-semibold text-accent tracking-[-0.02em]">{u.size}</span>
                  <span class="text-[16px] text-fg-muted ml-1.5">sqft built-up</span>
                </p>
              </div>
              <ul class="flex flex-wrap gap-x-7 gap-y-3 text-[15.5px] text-fg-muted">
                <li class="flex items-center gap-2"><Icon name="ph:bed" class="w-5 h-5 text-fg" aria-hidden="true" />{u.beds}</li>
                <li class="flex items-center gap-2"><Icon name="ph:shower" class="w-5 h-5 text-fg" aria-hidden="true" />{u.baths}</li>
                <li class="flex items-center gap-2"><Icon name="ph:car" class="w-5 h-5 text-fg" aria-hidden="true" />{u.parking}</li>
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
      <p class="text-[13px] text-fg-subtle leading-[1.6] max-w-[70ch]">
        Plans are shown blurred. The full floor plan is shared on request.
        Built-up areas are approximate and subject to final survey. All layouts
        are subject to variation by the developer and relevant authorities.
      </p>
      <a
        href={waLink(registerMessage)}
        target="_blank"
        rel="nofollow noopener noreferrer"
        class="btn-primary self-start md:self-auto"
      >
        <Icon name="ph:whatsapp-logo-fill" class="w-5 h-5 text-white" aria-hidden="true" />
        {ctaLabel}
      </a>
    </div>
  </div>
</section>
