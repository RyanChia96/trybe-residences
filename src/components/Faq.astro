---
import { Icon } from "astro-icon/components";
import { project, agency, agent } from "../config/site";

const faqs = [
  {
    q: `What is ${project.name}?`,
    a: `Hype 2 (Trybe) Residences is a freehold service apartment at Subang Jaya Xchange (SJX) in USJ7, Subang Jaya. Phase 1 is fully sold and Phase 2 is now open for registration.`,
  },
  {
    q: "Where exactly is it located?",
    a: "At Subang Jaya Xchange in USJ7, Subang Jaya, about 400m from the USJ7 LRT-BRT interchange station by covered walkway, with access to the KESAS, LDP, NPE and ELITE highways.",
  },
  {
    q: "Which train lines can I take from USJ7?",
    a: "USJ7 is an interchange for the LRT Kelana Jaya Line, which runs to SS15, KL Sentral and KLCC, and the BRT Sunway Line, which serves Sunway University, Sunway Medical Centre and Sunway Pyramid.",
  },
  {
    q: "What layouts and sizes are available?",
    a: "Two layouts: Type A / A-M at 730 sqft with 2 bedrooms, 2 bathrooms and 1 to 2 car park bays, and Type B / B-M at 920 sqft with 3 bedrooms, 2 bathrooms and 2 car park bays. Both include a hackable wall. Built-up areas are approximate and subject to final survey.",
  },
  {
    q: "Is it freehold?",
    a: "Yes. The developer has released the project as a freehold service apartment. Please confirm the title details in the Sale and Purchase Agreement before you buy.",
  },
  {
    q: "What is the early bird offer?",
    a: "The developer's early bird promotion offers savings of up to RM80K for the first 50 purchasers in Phase 2. Eligibility, the amount for each unit and the offer period are set by the developer and confirmed at booking.",
  },
  {
    q: "Is pricing available?",
    a: "We can share indicative pricing on enquiry. Any figure quoted is indicative only and is not binding until confirmed by the developer in the Sale and Purchase Agreement.",
  },
  {
    q: "Is this the developer's official website?",
    a: `No. This is an independent marketing website operated by ${agent.name} (${agent.ren}) of ${agency.name}, a registered estate agency (BOVAEP ${agency.licence}). It is not operated by or on behalf of the developer. All information here is for general reference and should be verified with the developer before any purchase decision.`,
  },
  {
    q: "How is my personal data handled?",
    a: "This website has no enquiry form and does not collect your details on-page. When you contact us on WhatsApp, by phone or by email, we use those details only to respond to your enquiry about this development, in accordance with Malaysia's Personal Data Protection Act 2010. You can ask us to stop contacting you at any time.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section id="faq" class="py-16 lg:py-24 px-gutter">
  <div class="max-w-[880px] mx-auto">
    <h2 class="text-[clamp(32px,4vw,52px)] font-semibold leading-[1.05] tracking-[-0.02em] mb-10" data-reveal>
      Questions buyers ask
    </h2>
    <div class="border-t border-line">
      {
        faqs.map((f) => (
          <details class="group border-b border-line">
            <summary class="flex items-start justify-between gap-6 cursor-pointer list-none py-6 text-[clamp(17px,1.7vw,20px)] font-medium [&::-webkit-details-marker]:hidden">
              {f.q}
              <Icon
                name="ph:plus"
                class="w-5 h-5 text-accent flex-none mt-1 transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              />
            </summary>
            <p class="text-[16px] leading-[1.7] text-fg-muted pb-7 max-w-[70ch]">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
